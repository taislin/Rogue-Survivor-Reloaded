# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
artifacts/

# Visual Studio / IDE state
.vs/
*.suo
*.user
*.rsuser
*.userosscache
*.sln.docstates
.idea/
.vscode/

# Test results / NuGet packages
[Tt]est[Rr]esults/
*.trx
packages/
*.nupkg
project.lock.json

# Node dependencies
#
# Unanchored, so it covers the root and any nested package directory. The web
# workspace has its own web/.gitignore, but a bare `node_modules/` at the repo
# root is easy to create by accident: running a bundler or a test runner from
# the root (rather than from web/) drops one there, and it is untracked and
# enormous. Redundancy with web/.gitignore is the cheap side of that trade.
node_modules/

# The assembled GitHub Pages site (web/scripts/build-site.mjs): docs/ at the
# root, the built game under game/. 37 MB, entirely regenerated by
# `npm run build:pages` and uploaded to Pages as an artifact. Uncommitted for
# the same reason web/dist is: it is build output, and the source of it is the
# two directories it is assembled from.
_site/

# Runtime-generated game data (saves, config, logs)
Config/
*.dat
log.txt
hiscores.txt

# The original C# game (Rogue Survivor Reloaded), kept as a local reference
# folder and no longer tracked. The port in web/ does not build against it and
# nothing in the test suite reads it any more: src/Resources/Data was the input
# to web/scripts/convert-csv.js, and web/tests/data-tables.test.ts compared the
# committed JSON against those CSVs until this commit removed that assertion.
# Balanced against web/, because a bare `src/` would swallow the TypeScript
# sources under web/src/, which are the whole game.
/src/

# MSVC debug symbols, alongside the project files above
*.pdb

# OS / editor junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*
*.tmp
*.bak
*.swp
*~

# CPython bytecode. The one-shot porting helpers under web/scripts/ are run in
# place, so running any of them drops a __pycache__/ next to it. Regenerated on
# every interpreter start, meaningless to a reader, and it went untracked here
# only because the helpers are. Unanchored so it covers wherever they get run.
__pycache__/
*.py[cod]

# Scratch icon copies in the repo root.
#
# The icons that actually ship live in web/public/ and are tracked there:
# web/public/icon-reloaded.png is the favicon, web/public/icon-{192,512,
# maskable-512}.png back the manifest and apple-touch-icon. These root copies
# are scratch working files, and committing them would create a second,
# silently-stale source of truth for the same artwork.
/icon.png
/icon_reloaded.png

# Layered source for the website's gameplay screenshots (1562x867 WebP pairs).
# Only the flattened WebP is published; the PSD is a 5.3 MB working file that
# nothing references, and committing it would add it to the Pages deploy for
# every visitor to download nothing from.
/docs/assets/img/screens/screens.psd
web/neutralinojs.log

_refs/