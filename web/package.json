{
  "name": "rogue-survivor-reloaded-web",
  "version": "0.1.0",
  "description": "Rogue Survivor Reloaded - Browser port (TypeScript)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "serve": "node dist-server/server/index.js",
    "build:server": "tsc -p server/tsconfig.json",
    "build:all": "npm run build && npm run build:server",
    "sim": "esbuild sim/cli.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=node_modules/.cache/sim.mjs --log-level=warning && node node_modules/.cache/sim.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run type-check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.3.2",
    "vite": "^5.0.4",
    "vitest": "^3.2.4"
  }
}
