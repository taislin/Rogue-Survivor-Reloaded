{
  "name": "rogue-survivor-reloaded-web",
  "version": "0.9.4",
  "description": "Rogue Survivor Reloaded - Browser port (TypeScript)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/stamp-cache-version.mjs",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "serve": "node dist-server/server/index.js",
    "build:server": "tsc -p server/tsconfig.json",
    "build:all": "npm run build && npm run build:server",
    "check:base": "node scripts/check-base.mjs",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "node scripts/preview-site.mjs",
    "build:pages": "npm run build && node scripts/stamp-cache-version.mjs && node scripts/build-site.mjs",
    "sim": "esbuild sim/cli.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=node_modules/.cache/sim.mjs --log-level=warning && node node_modules/.cache/sim.mjs",
      "test": "vitest run",
      "test:slow": "vitest run --mode slow",
      "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:serial": "vitest run --coverage --no-file-parallelism --coverage.reporter=text",
    "verify": "npm run type-check && npm run test:coverage && npm run build",
    "profile": "esbuild sim/profile.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=node_modules/.cache/profile.mjs --log-level=warning && node node_modules/.cache/profile.mjs",
    "neu:dev": "npx @neutralinojs/neu run",
    "neu:build": "npm run build && npx @neutralinojs/neu build",
    "build:desktop": "npm run build && npx @neutralinojs/neu build",
    "build:release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}