{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.roguesurvivor.reloaded",
  "version": "0.3.0",
  "name": "RogueSurvivorReloaded",
  "defaultMode": "window",
  "port": 0,
  "enableServer": true,
  "documentRoot": "/dist/",
  "url": "/index.html",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "modes": {
    "window": {
      "title": "Rogue Survivor Reloaded",
      "width": 1366,
      "height": 768,
      "minWidth": 800,
      "minHeight": 600,
      "fullScreen": false,
      "icon": "dist/icon-reloaded.png",
      "enableInspector": false,
      "maximize": false
    }
  },
  "cli": {
    "binaryName": "RogueSurvivorReloaded",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "clientLibrary": "public/js/neutralino.js",
    "resourcesPath": "dist/",
    "extensionsPath": "extensions/",
    "frontendLibrary": {
      "buildCommand": "npm run build",
      "devCommand": "npm run dev"
    }
  }
}